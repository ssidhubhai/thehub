# -------------------------------------------------------------
# The Hub - Production & Vercel Environment Variables
# -------------------------------------------------------------

# Gemini API Key (Required for AI features in full-stack mode)
GEMINI_API_KEY=""

# Public Application URL (Automatically populated on Vercel/Cloud Run)
APP_URL=""

# -------------------------------------------------------------
# Firebase Client Configuration (Optional for Vercel overrides)
# Note: If omitted, the app automatically falls back to bundled firebase-applet-config.json
# -------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
